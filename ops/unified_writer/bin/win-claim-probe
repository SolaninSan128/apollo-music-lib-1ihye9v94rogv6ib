#!/bin/bash
# Prove the mkdir claim conflicts. Does not publish and does not replace index.html.
# The directory must already exist. Live publish paths are refused.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -d "$HERE/unified_writer" ]; then PYROOT="$HERE"; else PYROOT="$(cd "$HERE/.." && pwd)"; fi
export HARMONIA_PATCH_ROOT="$PYROOT"
exec python3 -c '
import os, sys
from pathlib import Path
root = Path(os.environ["HARMONIA_PATCH_ROOT"]).resolve()
sys.path.insert(0, str(root))
import unified_writer
loaded = Path(unified_writer.__file__).resolve()
if loaded.parent.parent != root:
    sys.stderr.write("stale_package_shadow: %s\n" % loaded)
    raise SystemExit(76)
from unified_writer.winpub_lock import main
raise SystemExit(main(["probe", *sys.argv[1:]]))
' "$@"
